     Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["GETkpHam[n, input]"], "InlineFormula"], " \:2028",
        "constructs only the homogeneous order-n part of a k.p Hamiltonian using the legacy calling convention."}],
      "Usage"], Cell["GETkpHam is retained for notebooks written for earlier MagneticKP releases.", "Notes"],
     Cell["Use kpHam for new work, especially when multiple orders or diagnostic output are required.", "Notes"]},
    Open]], Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"],
