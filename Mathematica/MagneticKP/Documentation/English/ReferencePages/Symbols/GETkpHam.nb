  Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"],
     Cell["Construct only the first-order contribution:", "ExampleText"],
     Cell[BoxData["input = <|\n  \"Unitary\" -> <|\n    \"C2z\" -> {\n      {{0, 1}, {-1, 0}},\n      {-kx, -ky, kz}\n  \
  },\n    \"Inversion\" -> {\n      {{1, 0}, {0, -1}},\n      {-kx, -ky, -kz}\n    }\n  |>\n|>;\nGETkpHam[1, \
input][\"ham\"] // MatrixForm"], "Input"],
     Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{"0", RowBox[{RowBox[{RowBox[{"-", "kx"}], " ",
