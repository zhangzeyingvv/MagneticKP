Notebook[{Cell[CellGroupData[{Cell["highSymmetryKPath", "ObjectName"],
     Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["highSymmetryKPath[input]"], "InlineFormula"], " \:2028", "return\
s a local labeled momentum path obtained from the complete little magnetic co-group contained in interfaceRep input."}]\
, "Usage"], Cell["input is normally the Association returned by interfaceRep. A manually prepared input with \
three-dimensional momentum transformations is also accepted.", "Notes"], Cell["The default result is an ordinary path \
list. highSymmetryKPath does not call bandplot; pass the returned path to bandplot or bandManipulate in a separate \
step.", "Notes"], Cell["The path is centered at the local k.p expansion origin {0, 0, 0}. Each retained line has the \
complete largest magnetic subgroup that fixes a generic point on that line, and symmetry-equivalent lines are \
represented once by default.", "Notes"], Cell["Unitary and antiunitary little-co-group elements remain distinct even \
when they act on momentum in the same way. In returned diagnostics, SubgroupOrder is the full magnetic subgroup order, \
while MomentumActionOrder counts distinct momentum-action matrices.", "Notes"],
     Cell["highSymmetryKPath identifies symmetry lines; whether bands stay degenerate along a line depends on the \
selected representations and Hamiltonian.", "Notes"], Cell["Use \"ReturnData\" -> True to inspect the directions, \
subgroup orders, little co-group order, and the generated path together.", "Notes"],
     Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"Radius\"", "1/10",
          Cell["sets the extent of each path arm in the coordinate system used by input.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"Center\"", "{0, 0, 0}",
          Cell["sets the local center of the returned path.", "TableText"]}, {Cell["      ", "TableRowIcon"],
          "\"CenterLabel\"", "Automatic",
          Cell["uses the k-point label recorded by interfaceRep, or sets an explicit label string.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"EquivalentDirections\"", "\"Representatives\"",
          Cell["returns one representative of each symmetry-equivalent line class; \"All\" keeps every distinct line.",
           "TableText"]}, {Cell["      ", "TableRowIcon"], "\"IncludeNegativeDirections\"", "True",
          Cell["includes both arms of every line through the local center.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"ReturnData\"", "False",
          Cell["returns only the path, or an Association containing the path and symmetry diagnostics.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"MaxGroupOrder\"", "512",
          Cell["sets the largest little co-group order accepted while completing the supplied transformations.",
           "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MaxSubgroups\"", "4096",
          Cell["sets the largest number of subgroups enumerated while finding fixed lines.", "TableText"]}},
        GridBoxAlignment -> {"Columns" -> {{Left}}}]], "3ColumnTableMod"]}, Open]],
  Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"],
     Cell[BoxData["CompoundExpression[Needs[\"MagneticKP`\"], Needs[\"MSGCorep`\"]]"], "ExampleInitialization"]},
    Open]], Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"],
     Cell["Generate and display the path for K5 and K6 at K of magnetic space group 191.234:", "ExampleText"],
     Cell[BoxData["input = interfaceRep[\n  {191, 234}, \"K\", {5, 6},\n  \"CartesianCoordinates\" -> False\n];\npath = \
highSymmetryKPath[input]"], "Input"],
     Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0",
                       ",", RowBox[{"-", FractionBox["1", "10"]}]}], "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0",
                       ",", "0"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"L1-\"", ",", "\"K\""}], "}"}]}], "}"}],
           ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",",
                   RowBox[{"{", RowBox[{"0", ",", "0", ",", FractionBox["1", "10"]}], "}"}]}], "}"}], ",", RowBox[
                {"{", RowBox[{"\"K\"", ",", "\"L1+\""}], "}"}]}], "}"}], ",",
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", FractionBox["1", "10"]}], ",",
                       RowBox[{"-", FractionBox["1", "10"]}], ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[
                      {"0", ",", "0", ",", "0"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"L2-\"", ",", "\"K\""}],
                 "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0",
                       ",", "0"}], "}"}], ",", RowBox[{"{", RowBox[{FractionBox["1", "10"], ",", FractionBox["1",
                        "10"], ",", "0"}], "}"}]}], "}"}], ",", RowBox[{"{", RowBox[{"\"K\"", ",", "\"L2+\""}],
                 "}"}]}], "}"}]}], "}"}]], "Output"],
     Cell["Construct the first-order Hamiltonian and pass the displayed path directly to bandplot:", "ExampleText"],
     Cell[BoxData["ham = kpHam[1, input][\"ham\"];\nparams = Complement[Variables[ham], {kx, ky, kz}];\nrules = \
Thread[params -> N[Range[Length[params]]/10]];\nbandplot[\n  path, 30, ham, rules,\n  \"PlotRange\" -> All, FontSize -> \
16, ImageSize -> 500\n]"], "Input"],
