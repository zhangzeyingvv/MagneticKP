Notebook[{Cell[CellGroupData[{Cell["interfaceRep", "ObjectName"],
     Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["interfaceRep[group, k, rep]"], "InlineFormula"], " \:2028",
        "converts SpaceGroupIrep or MSGCorep representation data into input accepted by kpHam."}], "Usage"],
     Cell["Use an integer group number with SpaceGroupIrep and a BNS pair {spaceGroup, serial} with MSGCorep.",
      "Notes"], Cell["k may be a high-symmetry-point label or exact coordinates. rep may select one representation or a \
list whose direct sum is required.", "Notes"],
     Cell["For MSGCorep, each integer in rep selects the row with that Index in showMLGCorep; here {2} selects B_2.",
      "Notes"], Cell["The returned Association records the selected k-point label and coordinate system so \
highSymmetryKPath can label a local path automatically.", "Notes"],
     Cell["Load SpaceGroupIrep or MSGCorep before calling interfaceRep.", "Notes"],
     Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"CartesianCoordinates\"", "True",
          Cell["specifies whether symmetry operations are converted to Cartesian momentum coordinates.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"CalculateGenerators\"", "True",
          Cell["specifies whether the returned input contains a generating subset instead of every group element.",
           "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}]], "3ColumnTableMod"]}, Open]],
