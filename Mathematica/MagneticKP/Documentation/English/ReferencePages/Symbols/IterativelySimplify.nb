Notebook[{Cell[CellGroupData[{Cell["IterativelySimplify", "ObjectName"],
     Cell[TextData[{Cell["   ", "ModInfo"], Cell[BoxData["IterativelySimplify[korder, input]"], "InlineFormula"],
        " \:2028", "constructs a symmetry-allowed k.p Hamiltonian with the default solver."}], "Usage"],
     Cell["An integer korder includes every order from zero through korder; a list selects only the listed homogeneous \
orders.", "Notes"], Cell["The return format is the same Association used by kpHam.", "Notes"],
     Cell[BoxData[GridBox[{{Cell["      ", "TableRowIcon"], "\"GroupInput\"", "Automatic",
          Cell["specifies whether the supplied symmetry data contains generators or all elements; Automatic uses \
metadata in input when available.", "TableText"]}, {Cell["      ", "TableRowIcon"], "\"MaxGroupOrder\"", "512",
          Cell["sets the largest finite group order accepted while completing generator input.", "TableText"]},
         {Cell["      ", "TableRowIcon"], "\"ReturnDiagnostics\"", "False",
          Cell["specifies whether the returned Association also includes per-order diagnostic information.",
           "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}]], "3ColumnTableMod"]}, Open]],
  Cell[CellGroupData[{Cell["Examples Initialization", "ExamplesInitializationSection"],
     Cell[BoxData["Needs[\"MagneticKP`\"]"], "ExampleInitialization"]}, Open]],
  Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"],
     Cell["Construct all terms through first order:", "ExampleText"],
     Cell[BoxData["input = <|\n  \"Unitary\" -> <|\n    \"C2z\" -> {\n      {{0, 1}, {-1, 0}},\n      {-kx, -ky, kz}\n  \
  },\n    \"Inversion\" -> {\n      {{1, 0}, {0, -1}},\n      {-kx, -ky, -kz}\n    }\n  |>\n|>;\nIterativelySimplify[1, \
input][\"ham\"] // MatrixForm"], "Input"],
     Cell[BoxData[TagBox[RowBox[{"(", "\:2060", GridBox[{{SubscriptBox["e", "1"],
             RowBox[{RowBox[{RowBox[{"-", "kx"}], " ", SubscriptBox["t", "1"]}], "-", RowBox[{"ky", " ",
                 SubscriptBox["t", "2"]}], "+", RowBox[{"\:f74e", " ", "kz", " ", SubscriptBox["t", "3"]}]}]},
            {RowBox[{RowBox[{RowBox[{"-", "kx"}], " ", SubscriptBox["t", "1"]}], "-", RowBox[{"ky", " ",
                 SubscriptBox["t", "2"]}], "-", RowBox[{"\:f74e", " ", "kz", " ", SubscriptBox["t", "3"]}]}],
             SubscriptBox["e", "1"]}}, RowSpacings -> 1, ColumnSpacings -> 1, RowAlignments -> Baseline,
           ColumnAlignments -> Center], "\:2060", ")"}], Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]], "Output"]},
