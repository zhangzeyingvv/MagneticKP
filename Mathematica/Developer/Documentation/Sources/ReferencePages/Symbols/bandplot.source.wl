  Cell[CellGroupData[{Cell["Basic Examples", "PrimaryExamplesSection"],
     Cell[
      "Construct a first-order two-band Hamiltonian with kpHam and assign a numerical value to every model parameter:",
      "ExampleText"], Cell[BoxData["input = <|\n  \"Unitary\" -> <|\n    \"C2z\" -> {\n      {{0, 1}, {-1, 0}},\n      \
{-kx, -ky, kz}\n    },\n    \"Inversion\" -> {\n      {{1, 0}, {0, -1}},\n      {-kx, -ky, -kz}\n    }\n  |>\n|>;\nham \
= kpHam[1, input][\"ham\"];\nparams = Complement[Variables[ham], {kx, ky, kz}];\nrules = Thread[params -> \
N[Range[Length[params]]/5]];\npath = {\n  {{{0, 0, 0}, {1/3, 0, 0}}, {\"G\", \"X\"}},\n  {{{1/3, 0, 0}, {1/3, 1/3, 0}}, \
{\"X\", \"M\"}}\n};\n{Dimensions[ham], rules}"], "Input"],
